# ─── App ──────────────────────────────────────────────────────────
# Desenvolvimento: http://localhost:3000
# Preview Vercel:  https://<projeto>-<hash>.vercel.app
# Produção:        https://seudominio.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Banco de dados ───────────────────────────────────────────────
# Supabase → Settings → Database → Connection string
# Use "Transaction pooler" para DATABASE_URL (porta 6543, modo serverless)
# Use "Session pooler" ou "Direct" para DIRECT_URL (porta 5432, migrações)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────
# Supabase → Settings → API → Project URL e anon/public key
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
