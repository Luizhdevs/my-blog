# ─── App ──────────────────────────────────────────────────────────
# Desenvolvimento: http://localhost:3000
# Preview Vercel:  https://<projeto>-<hash>.vercel.app
# Produção:        https://seudominio.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Banco de dados ───────────────────────────────────────────────
# Supabase → Settings → Database → Connection string
# Use "Transaction pooler" para DATABASE_URL (porta 6543, modo serverless)
# Use "Session pooler" ou "Direct" para DIRECT_URL (porta 5432, migrações)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────
# Supabase → Settings → API → Project URL e anon/public key
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# ─── Google Analytics 4 ───────────────────────────────────────────
# GA4 → Admin → Data Streams → seu stream → Measurement ID
# Só carrega em NODE_ENV=production
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Google Search Console ────────────────────────────────────────
# Search Console → Configurações → Verificar propriedade → Tag HTML
# Cole apenas o valor do atributo content="..." (sem aspas)
NEXT_PUBLIC_GSC_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
